{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "convert",
  "title": "Web Converter",
  "description": "Converts everything web related: rem, px, pt, hex, hex (with opacity), rgb, rgba, hsl, hsla, oklch and shows the closest Tailwind CSS color.",
  "icon": "assets/icon.png",
  "author": "almatkai",
  "contributors": [
    "yusifaliyevpro",
    "ridemountainpig",
    "cedric25"
  ],
  "categories": [
    "Developer Tools",
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "convert",
      "title": "Convert Unit",
      "description": "Converts everything web related: rem, px, pt, hex, hex (with opacity), rgb, rgba, hsl, hsla, oklch and shows the closest Tailwind CSS color.",
      "mode": "view",
      "preferences": [
        {
          "name": "basePixel",
          "type": "textfield",
          "required": false,
          "title": "Base PX Value",
          "description": "The conversion will be calculated based on this property. Default 16px",
          "placeholder": "16"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.convert",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "repository": "https://github.com/almatkai/convert",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/convert",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    },
    "linuxStatus": "coming-soon"
  }
}
